
# This file is an example. Create a .env.local file to manage your environment variables.
# Do not commit .env.local to your repository.

# Shopify Storefront API Configuration
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN="your_storefront_access_token"

# Shopify Admin API (for order management and inventory sync)
SHOPIFY_ADMIN_ACCESS_TOKEN="your_admin_access_token"

# Firebase Config
NEXT_PUBLIC_FIREBASE_API_KEY="your_firebase_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_app_id"

# Payment Gateway Configuration (optional - to be implemented)
# PAYMENT_GATEWAY_API_KEY="your_payment_gateway_key"
# PAYMENT_GATEWAY_SECRET="your_payment_gateway_secret"

# Redis connection (optional, for session management and caching)
# REDIS_HOST="127.0.0.1"
# REDIS_PORT="6379"
# REDIS_PASSWORD=""

# Application Configuration
NEXT_PUBLIC_APP_URL="http://localhost:9002"
NEXT_PUBLIC_CURRENCY="DZD"

# Security
JWT_SECRET="your_jwt_secret_here_change_in_production"
ENCRYPTION_KEY="your_encryption_key_here_change_in_production"
