# This file is an example. Create a .env.local file to manage your environment variables.
# Do not commit .env.local to your repository.

# Example API Key
# NEXT_PUBLIC_EXAMPLE_API_KEY="your_api_key_here"

# Firebase Project Config (if needed on server-side, though often better to use Admin SDK)
# Note: NEXT_PUBLIC_ prefix makes it available in the browser.
NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"
