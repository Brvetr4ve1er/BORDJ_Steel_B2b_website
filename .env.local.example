
# This file is an example. Create a .env.local file to manage your environment variables.
# Do not commit .env.local to your repository.

# Example API key
# SOME_API_KEY="your_api_key_here"

# Firebase Config (if needed on the server, though usually handled by Admin SDK)
# FIREBASE_PROJECT_ID="your-project-id"

# Redis connection (optional, for ioredis)
# REDIS_HOST="127.0.0.1"
# REDIS_PORT="6379"
