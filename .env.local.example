# This file is an example. Create a .env.local file to manage your environment variables.
# Do not commit .env.local to your repository.

# ---------------------------------------------------------------------------
# Contact form delivery (src/app/api/contact/route.ts)
#
# Without BOTH of these the route returns 503 and the form shows the direct
# e-mail address instead. It never reports success for a message it did not
# send — that was the defect the mailto: version had.
#
# The destination is NOT configured here. It is read from
# companyData.pages.contact.content.emails[0] so the address shown on the page
# and the address messages arrive at cannot drift apart.
# ---------------------------------------------------------------------------

# Resend API key — https://resend.com/api-keys
# RESEND_API_KEY="re_..."

# The From address. Resend will only send from a domain verified in the Resend
# dashboard (DNS records), so this cannot simply be set to an address at
# bordjsteel.dz and expected to work — that domain has to be verified first.
# For testing before DNS is in place, Resend accepts "onboarding@resend.dev",
# which delivers ONLY to the Resend account owner's own address.
# CONTACT_FROM="Bordj Steel <contact@bordjsteel.dz>"
